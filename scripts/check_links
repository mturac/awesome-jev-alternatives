#!/usr/bin/env python3
"""Check README links and GitHub activity for this list.

Every http(s) link in README.md must finish at HTTP 200.
github.com/owner/repo links are also loaded from the GitHub API.
Archived repositories fail. A repository whose default branch was last
pushed more than 365 days ago fails, unless it is listed in HISTORICAL.

The GitHub API is called through the `gh` CLI when that works, and
otherwise through urllib. A token is read from GITHUB_TOKEN or GH_TOKEN
if one is already in the environment. This script does not read git
remotes or credential files.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
README = ROOT / "README.md"
USER_AGENT = "awesome-jev-alternatives-check"
ACTIVITY_WINDOW = timedelta(days=365)

# Reference implementations that predate the activity window.
HISTORICAL = {
    "gpleiss/temperature_scaling": "scalar temperature scaling, last push 2025-07-26",
    "MoritzLaurer/zeroshot-classifier": "NLI zero-shot training notebooks, last push 2024-12-28",
}

LINK_RE = re.compile(r"(?<!!)\[[^\]]*\]\((https?://[^)\s]+)\)")
REPO_RE = re.compile(r"^https?://github\.com/([^/]+)/([^/#?]+)")


def github_full_name(url: str) -> str | None:
    match = REPO_RE.match(url)
    if not match:
        return None
    owner, repo = match.group(1), match.group(2)
    if owner.lower() in {"topics", "features", "settings", "orgs", "marketplace"}:
        return None
    if repo.lower() in {"issues", "pulls"}:
        return None
    return f"{owner}/{repo.removesuffix('.git')}"


def http_status(url: str) -> tuple[int | None, str]:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            response.read(256)
            return response.status, response.geturl()
    except urllib.error.HTTPError as error:
        return error.code, url
    except urllib.error.URLError as error:
        return None, str(error.reason)


def redact(text: str) -> str:
    text = re.sub(r"ghp_[A-Za-z0-9]+", "[redacted]", text)
    text = re.sub(r"github_pat_[A-Za-z0-9_]+", "[redacted]", text)
    text = re.sub(r"x-access-token:[^@\s]+", "x-access-token:[redacted]", text)
    return text


def repo_from_gh(full_name: str) -> dict | None:
    if shutil.which("gh") is None:
        return None
    completed = subprocess.run(
        ["gh", "api", f"repos/{full_name}"],
        check=False,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        return None
    return json.loads(completed.stdout)


def repo_from_urllib(full_name: str) -> dict:
    request = urllib.request.Request(
        f"https://api.github.com/repos/{full_name}",
        headers={
            "User-Agent": USER_AGENT,
            "Accept": "application/vnd.github+json",
        },
    )
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode())


def load_repo(full_name: str) -> dict:
    payload = repo_from_gh(full_name)
    if payload is not None:
        return payload
    return repo_from_urllib(full_name)


def main() -> int:
    text = README.read_text(encoding="utf-8")
    urls = list(dict.fromkeys(LINK_RE.findall(text)))
    if not urls:
        print("No links found in README.md", file=sys.stderr)
        return 1

    failures: list[str] = []
    seen_repos: set[str] = set()
    now = datetime.now(timezone.utc)
    cutoff = now - ACTIVITY_WINDOW

    for url in urls:
        status, detail = http_status(url)
        if status != 200:
            failures.append(f"HTTP {status} {url} ({detail})")
            print(f"FAIL  http {status}  {url}")
        else:
            print(f"OK    http 200  {url}")

        full_name = github_full_name(url)
        if full_name is None or full_name in seen_repos:
            continue
        seen_repos.add(full_name)
        try:
            repo = load_repo(full_name)
        except (urllib.error.URLError, json.JSONDecodeError, subprocess.SubprocessError) as error:
            failures.append(f"API {full_name}: {redact(str(error))}")
            print(f"FAIL  api {full_name}")
            continue

        license_info = repo.get("license") or {}
        spdx = license_info.get("spdx_id") or "missing"
        stars = repo.get("stargazers_count")
        pushed_raw = repo.get("pushed_at") or ""
        pushed = datetime.fromisoformat(pushed_raw.replace("Z", "+00:00"))
        archived = bool(repo.get("archived") or repo.get("disabled"))
        stale = pushed < cutoff
        historical = full_name in HISTORICAL
        marker = "historical" if historical else "active"
        print(
            f"OK    repo {full_name}  stars={stars}  license={spdx}  "
            f"pushed={pushed.date().isoformat()}  {marker}"
        )
        if archived:
            failures.append(f"archived {full_name}")
            print(f"FAIL  archived {full_name}")
        elif stale and not historical:
            failures.append(
                f"stale {full_name} pushed {pushed.date().isoformat()}"
            )
            print(f"FAIL  stale {full_name} pushed {pushed.date().isoformat()}")

    print(
        f"\n{len(urls)} links, {len(seen_repos)} GitHub repos, {len(failures)} failures"
    )
    if failures:
        print("Failures:")
        for item in failures:
            print(f"  - {item}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
